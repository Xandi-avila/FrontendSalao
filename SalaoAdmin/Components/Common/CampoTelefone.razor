<MudTextField Value="_exibicao"
              ValueChanged="@(async (string? v) => await AoDigitar(v))"
              Label="@Rotulo"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Required="@Obrigatorio"
              Error="@ComErro"
              ErrorText="@TextoErro"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Phone"
              MaxLength="@(_comprimentoMaximo ?? 524288)"
              Immediate="true" />

@code {
    [Parameter] public string Rotulo { get; set; } = "Telefone / WhatsApp";
    [Parameter] public string? Valor { get; set; }
    [Parameter] public EventCallback<string?> ValorChanged { get; set; }
    [Parameter] public bool Obrigatorio { get; set; }
    [Parameter] public bool ComErro { get; set; }
    [Parameter] public string? TextoErro { get; set; }
    [Parameter] public int? MaxDigitos { get; set; }

    private string? _exibicao;
    private int? _comprimentoMaximo;

    protected override void OnParametersSet()
    {
        _exibicao = FormatacaoCampos.Telefone(Valor);
        _comprimentoMaximo = MaxDigitos switch
        {
            11 => 15,
            10 => 14,
            _ => null
        };
    }

    private async Task AoDigitar(string? texto)
    {
        var digitos = FormatacaoCampos.SoNumeros(texto ?? string.Empty);
        if (MaxDigitos.HasValue && digitos.Length > MaxDigitos.Value)
            digitos = digitos[..MaxDigitos.Value];

        _exibicao = FormatacaoCampos.Telefone(digitos);
        await ValorChanged.InvokeAsync(_exibicao);
    }
}

